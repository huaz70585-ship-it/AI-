PORT=3001
DB_PATH=./data/travel.db
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5175

# 腾讯位置服务（lbs.qq.com）Key，供 utils/geo.js 在线地理编码使用。
# 未配置时在线查询返回 skipped，不影响已缓存的 geo_cache 数据与前端地图打点。
# 注意：前端 TripMap 用的是「JavaScript API GL」类型的 Key（VITE_TMAP_KEY），
# 后端这里用「WebServiceAPI」类型；同一个 Key 勾选两种服务也可以，但权限要分别开通。
TENCENT_MAP_KEY=
